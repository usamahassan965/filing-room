.env
.conda/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Caches and corpora are reproducible; results are not.
.cache/
data/*
!data/.gitkeep
qdrant_storage/
phoenix_data/

# The one exception. facts.duckdb is a pure function of the JSON on disk and
# rebuilds in 25 seconds, so it stays out. manifest.duckdb is not reproducible
# without re-downloading 1.1 GB from a host that rate-limits to 10 req/s, and it
# is the only record of what was fetched, when, and with which hash. 3.4 MB is a
# cheap price for making the corpus rebuildable from a clone.
!data/manifest.duckdb

# The eval set is the other exception, and for the opposite reason. The manifest
# is committed because rebuilding it needs the corpus; this is committed because
# no amount of corpus would produce it again -- seventy of its questions were
# written by a person, and a measurement is only comparable across time if the
# questions it was taken on are the same file. 168 KB, versioned in its filename.
!data/eval/
!data/eval/**

# Results are the deliverable and go in. The per-question cache underneath them
# is a local convenience -- 150 files per configuration, rewritten whenever a
# fingerprint changes -- and it reconstructs itself from one run.
results/cache/

# Local editor/agent state, not project configuration.
.claude/settings.local.json

# A subset run is a real artifact but never a committed one -- see runner.run.
results/*.partial.*
