# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real key in it.

# ---------------------------------------------------------------- providers
# Two settings, because generation and retrieval buy different things.
#
# LLM_BACKEND answers questions: gemini | nvidia | ollama. One hosted call per
# answer, which is where a frontier model is worth the quota.
LLM_BACKEND=gemini

# EMBED_BACKEND owns the vector space: local | gemini | nvidia | ollama. One
# call per *chunk*, and that is the axis that scales with the corpus. The free
# tier meters embeddings per document per day -- batchEmbedContents bills every
# text in the batch separately against a 1,000/day cap -- so 32,218 chunks is
# 33 days of hosted allowance and one afternoon of CPU. Default is local.
#
# This is not a setting to flip casually: the Qdrant collection is named after
# backend + model + dim, so changing it means rebuilding the index rather than
# silently querying one vector space with another one's vectors.
EMBED_BACKEND=local

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed on LLM_BACKEND=nvidia -- https://build.nvidia.com
NVIDIA_API_KEY=

# Only needed on LLM_BACKEND=ollama, and only if it is not on the default port.
# OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------- EDGAR
# REQUIRED before `filing ingest`. SEC's fair-access policy asks every automated
# client to identify itself with a real contact address, and answers anything
# else with a bare 403 -- no explanation, no retry that helps. Use your own name
# and an address you actually read.
SEC_USER_AGENT=Jane Doe jane@example.com

# Requests per *second*, not per minute. SEC's ceiling is 10; the default of 8
# leaves headroom, because a breach is answered with a timed IP block rather
# than with throttling.
# SEC_RPS=8

# --------------------------------------------------------------------- budget
# Fallback rpm for models whose registry entry does not set their own.
# RATE_LIMIT_RPM=35
# REQUEST_TIMEOUT_S=90

# -------------------------------------------------------------- observability
# TRACING_ENABLED=true
# PHOENIX_ENDPOINT=http://localhost:6006
