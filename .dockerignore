# The build context is uploaded to the daemon before the first instruction
# runs, so this file is not tidiness -- without it every `docker build` ships
# 1.2 GB of filings, a Qdrant volume and a Phoenix database across the socket
# before printing "Step 1".
data/*
!data/eval
!data/eval/**
qdrant_storage/
phoenix_data/
.cache/
results/cache/

.git/
.github/
.conda/
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Never build a key into an image.
.env
